{
  "name": "teslamatefix",
  "version": "0.8.0",
  "private": true,
  "description": "Application Next.js mobile-first pour corriger les données collectées par TeslaMate (drives, charges, positions, états).",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:pull": "prisma db pull",
    "db:studio": "prisma studio",
    "db:check": "node --env-file=.env scripts/check-db.mjs",
    "auth:hash": "node scripts/hash-password.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-table": "^9.2.8",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iron-session": "^9.0.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "mysql2": "^3.24.5",
    "deepmerge-ts": "^8.0.2"
  }
}
